# Flask
FLASK_SECRET_KEY=          # generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_ENV=production       # set to "production" once on HTTPS, so cookies are Secure

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # set when you add the webhook in the Razorpay dashboard (step 6 in README_DEPLOY)

# Pricing
PRICE_INR=499
APP_NAME=Annual Report Extractor
PORT=5000
